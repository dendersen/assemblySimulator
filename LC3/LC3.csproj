<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\assemblySimulator\assemblySimulator.csproj" />
  </ItemGroup>

  <Target Name="CopyPluginToSimulator" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(MSBuildProjectDirectory)/../assemblySimulator/bin/$(Configuration)/net10.0" />
  </Target>

</Project>
